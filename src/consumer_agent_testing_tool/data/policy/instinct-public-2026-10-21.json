  "observations": [
    {
      "id": "communication",
      "basis": "documented",
      "sources": [
        "homepage",
        "launch",
        "email"
      ],
      "detail": "Instinct describes text and phone interaction, computer and phone use, and agent-owned email. Exact delivery and tool contracts are not published."
    },
    {
      "id": "connected-context",
      "basis": "documented",
      "sources": [
        "privacy",
        "terms"
      ],
      "detail": "Connected accounts can supply indexed context and authorize actions. Disconnecting future account access and deleting indexed data are distinct controls."
    },
    {
      "id": "trusted-network",
      "basis": "documented",
      "sources": [
        "network-launch",
        "network-update"
      ],
      "detail": "The founder describes communication restricted to trusted people, explicit approval of connection requests, invitation revocation and encrypted file delivery. No communication or cryptographic protocol is specified."
    },
    {
      "id": "vault",
      "basis": "documented",
      "sources": [
        "terms",
        "vault-totp"
      ],
      "detail": "Vault holds account information and can support authenticator enrollment and TOTP use. Some initial or phone security checks still require the user."
    },
    {
      "id": "files",
      "basis": "documented",
      "sources": [
        "files"
      ],
      "detail": "Instinct Files are private or public interactive pages shareable by link. They are not documented as MCP Apps or Muse widgets."
    },
    {
      "id": "security-claims",
      "basis": "documented",
      "sources": [
        "security"
      ],
      "detail": "The founder describes isolated sandboxes, short-lived credentials, signed tool execution and an active hallucination monitor. These vendor statements are not independent verification or implementations shipped by CATT."
    },
    {
      "id": "client-observations",
      "basis": "documented",
      "sources": [
        "web-client"
      ],
      "detail": "The delivered browser client references Vault, trusted networks, account connections, Workspace, Link, 1Password and local-browser features. Client references do not establish availability or server behavior."
    },
    {
      "id": "payment-provider",
      "basis": "documented",
      "sources": [
        "stripe-wallet"
      ],
      "detail": "Stripe documents customer-approved spend requests and single-use payment credentials. This is the provider contract, not proof of the flow used by every Instinct purchase."
    },
    {
      "id": "mcp",
      "basis": "unknown",
      "sources": [
        "homepage",
        "web-client"
      ],
      "detail": "No public Instinct MCP integration contract was found. CATT uses its generic MCP adapter as an explicit assumption."
    }
  ],
  "limits": [
    "No Instinct account, live message, purchase, private API or paid inference was used for research.",
    "No real-Instinct calibration, compatibility certification or admission claim.",
    "Text formatting, permissions, transport, browser task APIs and supported extensions are local CATT assumptions.",
    "The private model, system prompt, security monitor, isolation, Vault, payment and trusted-network protocols are not reproduced."
  ]
