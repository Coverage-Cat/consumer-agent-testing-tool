{
  "$defs": {
    "CaseInputs": {
      "additionalProperties": false,
      "properties": {
        "scenario": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scenario",
          "type": "string"
        },
        "script": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Script"
        },
        "manifest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manifest"
        },
        "docs": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Docs",
          "type": "string"
        },
        "service": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Service",
          "type": "string"
        },
        "readiness_connector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Readiness Connector"
        }
      },
      "required": [
        "scenario",
        "script",
        "manifest",
        "docs",
        "service",
        "readiness_connector"
      ],
      "title": "CaseInputs",
      "type": "object"
    },
    "CaseResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "definition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "expected-failure",
            "failed",
            "blocked",
            "error",
            "cancelled",
            "not-run"
          ],
          "title": "Status",
          "type": "string"
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Exit Code",
          "type": "integer"
        },
        "seconds": {
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        },
        "attempts": {
          "enum": [
            0,
            1
          ],
          "title": "Attempts",
          "type": "integer"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "compatibility_pass": {
          "title": "Compatibility Pass",
          "type": "boolean"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,120}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "id",
        "definition_sha256",
        "status",
        "exit_code",
        "seconds",
        "attempts",
        "outcome",
        "checks",
        "compatibility_pass"
      ],
      "title": "CaseResult",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "no-finding",
            "warning",
            "info",
            "failed",
            "blocked",
            "observation-gap",
            "unsupported",
            "not-evaluated"
          ],
          "title": "Status",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "detail": {
          "maxLength": 2000,
          "title": "Detail",
          "type": "string"
        },
        "failure_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Class"
        }
      },
      "required": [
        "id",
        "status",
        "required",
        "detail"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "action": {
          "enum": [
            "fix-input",
            "inspect-checks",
            "inspect-private-evidence",
            "reconcile-before-rerun",
            "complete-coverage",
            "supply-observation"
          ],
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "action"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Expectation": {
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "default": 0,
          "enum": [
            0,
            1,
            3
          ],
          "title": "Exit Code",
          "type": "integer"
        },
        "checks": {
          "additionalProperties": {
            "enum": [
              "failed",
              "blocked",
              "unsupported",
              "observation-gap",
              "not-evaluated"
            ],
            "type": "string"
          },
          "maxProperties": 100,
          "title": "Checks",
          "type": "object"
        },
        "failure_class": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9 _./-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Class"
        },
        "failure_stage": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9 _./-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Stage"
        }
      },
      "title": "Expectation",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "enum": [
            0,
            1,
            2,
            3
          ],
          "title": "Exit Code",
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "blocked",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "failure_stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Stage"
        },
        "failure_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Class"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        }
      },
      "required": [
        "exit_code",
        "status",
        "failure_stage",
        "failure_class",
        "reason"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "PlanCase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,299}$",
          "title": "Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Source Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "connector",
            "readiness"
          ],
          "title": "Kind",
          "type": "string"
        },
        "definition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "treatment": {
          "$ref": "#/$defs/Treatment"
        },
        "service": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Service",
          "type": "string"
        },
        "state": {
          "enum": [
            "process-local",
            "case-isolated",
            "shared"
          ],
          "title": "State",
          "type": "string"
        },
        "network": {
          "enum": [
            "loopback",
            "remote"
          ],
          "title": "Network",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "timeout_seconds": {
          "title": "Timeout Seconds",
          "type": "number"
        },
        "expect": {
          "$ref": "#/$defs/Expectation"
        },
        "inputs": {
          "$ref": "#/$defs/CaseInputs"
        },
        "required_checks": {
          "items": {
            "type": "string"
          },
          "title": "Required Checks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source_id",
        "kind",
        "definition_sha256",
        "treatment",
        "service",
        "state",
        "network",
        "tags",
        "timeout_seconds",
        "expect",
        "inputs",
        "required_checks"
      ],
      "title": "PlanCase",
      "type": "object"
    },
    "SuitePlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "catt-ci-plan",
          "default": "catt-ci-plan",
          "title": "Kind",
          "type": "string"
        },
        "suite_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Suite Id",
          "type": "string"
        },
        "suite_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Suite Sha256",
          "type": "string"
        },
        "scope_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scope Sha256",
          "type": "string"
        },
        "evidence_label": {
          "const": "scripted surrogate compatibility; no model inference",
          "default": "scripted surrogate compatibility; no model inference",
          "title": "Evidence Label",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/PlanCase"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "selected": {
          "items": {
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Selected",
          "type": "array"
        },
        "scheduled": {
          "items": {
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Scheduled",
          "type": "array"
        },
        "shard_index": {
          "maximum": 512,
          "minimum": 1,
          "title": "Shard Index",
          "type": "integer"
        },
        "shard_count": {
          "maximum": 512,
          "minimum": 1,
          "title": "Shard Count",
          "type": "integer"
        }
      },
      "required": [
        "suite_id",
        "suite_sha256",
        "scope_sha256",
        "cases",
        "selected",
        "scheduled",
        "shard_index",
        "shard_count"
      ],
      "title": "SuitePlan",
      "type": "object"
    },
    "Treatment": {
      "additionalProperties": false,
      "properties": {
        "emulation_target": {
          "enum": [
            "muse",
            "instinct"
          ],
          "title": "Emulation Target",
          "type": "string"
        },
        "projection": {
          "enum": [
            "native",
            "cli",
            "muse-cli"
          ],
          "title": "Projection",
          "type": "string"
        },
        "exposure": {
          "enum": [
            "in-prompt",
            "search-only"
          ],
          "title": "Exposure",
          "type": "string"
        },
        "client_profile": {
          "enum": [
            "generic-sdk",
            "muse-template-unofficial-2026-10"
          ],
          "title": "Client Profile",
          "type": "string"
        },
        "output_schema": {
          "enum": [
            "lenient",
            "strict"
          ],
          "title": "Output Schema",
          "type": "string"
        }
      },
      "required": [
        "emulation_target",
        "projection",
        "exposure",
        "client_profile",
        "output_schema"
      ],
      "title": "Treatment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "catt-ci-report",
      "default": "catt-ci-report",
      "title": "Kind",
      "type": "string"
    },
    "report_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Report Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "evidence_label": {
      "const": "scripted surrogate compatibility; no model inference",
      "default": "scripted surrogate compatibility; no model inference",
      "title": "Evidence Label",
      "type": "string"
    },
    "harness": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Harness",
      "type": "object"
    },
    "batch_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
      "title": "Batch Id",
      "type": "string"
    },
    "build_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Build Id"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/SuitePlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseResult"
      },
      "title": "Cases",
      "type": "array"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3
      ],
      "title": "Exit Code",
      "type": "integer"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "error",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "seconds": {
      "minimum": 0,
      "title": "Seconds",
      "type": "number"
    },
    "jobs": {
      "maximum": 64,
      "minimum": 1,
      "title": "Jobs",
      "type": "integer"
    },
    "model_requests": {
      "const": 0,
      "default": 0,
      "title": "Model Requests",
      "type": "integer"
    },
    "compatibility_pass": {
      "title": "Compatibility Pass",
      "type": "boolean"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "fatal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Diagnostic"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "merged_from": {
      "items": {
        "type": "string"
      },
      "title": "Merged From",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "created_at",
    "harness",
    "batch_id",
    "plan",
    "cases",
    "exit_code",
    "status",
    "seconds",
    "jobs",
    "compatibility_pass",
    "content_sha256"
  ],
  "title": "SuiteReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:consumer-agent-testing-tool:ci-report-v1"
}
