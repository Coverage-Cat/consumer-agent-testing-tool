        "final_response": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Response"
        },
        "final_consistent": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Consistent"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        }
      },
      "required": [
        "sources",
        "identity",
        "assessment"
      ],
      "title": "ObservedSide",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "milestone": {
          "minLength": 1,
          "title": "Milestone",
          "type": "string"
        },
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "arguments": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arguments"
        }
      },
      "required": [
        "milestone",
        "operation"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Operations": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "completeness",
        "items"
      ],
      "title": "Operations",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "transcript",
            "screenshot",
            "target-requests",
            "backend-state"
