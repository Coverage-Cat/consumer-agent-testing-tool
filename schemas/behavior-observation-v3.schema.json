          "title": "Kind",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "precision": {
          "default": "unknown",
          "enum": [
            "millisecond",
            "second",
            "minute",
            "unknown"
          ],
          "title": "Precision",
          "type": "string"
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "service",
            "native-transcript",
            "room-fetch",
            "operator-copy",
            "fixture",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ],
      "title": "Source",
      "type": "object"
