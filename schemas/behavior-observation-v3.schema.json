{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "completion": {
          "enum": [
            "completed",
            "incomplete",
            "unknown"
          ],
          "title": "Completion",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "observed",
            "blocked",
            "forgone"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "exposure": {
          "enum": [
            "reached",
            "not-reached",
            "unknown"
          ],
          "title": "Exposure",
          "type": "string"
        },
        "infrastructure": {
          "enum": [
            "observed-healthy",
            "interrupted",
            "unknown"
          ],
          "title": "Infrastructure",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "supported",
            "contradicted",
            "inconclusive"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "dispatch_guard": {
          "default": false,
          "title": "Dispatch Guard",
          "type": "boolean"
        }
      },
      "required": [
        "completion",
        "disposition",
        "exposure",
        "infrastructure",
        "verdict"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "account_cohort": {
          "minLength": 1,
          "title": "Account Cohort",
          "type": "string"
        },
        "session_cohort": {
          "minLength": 1,
          "title": "Session Cohort",
          "type": "string"
        },
        "prior_context": {
          "minLength": 1,
          "title": "Prior Context",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "profile",
        "account_cohort",
        "session_cohort",
        "prior_context"
      ],
      "title": "Identity",
      "type": "object"
    },
    "Intervention": {
      "additionalProperties": false,
      "properties": {
        "milestone": {
          "minLength": 1,
          "title": "Milestone",
          "type": "string"
        },
        "kind": {
          "enum": [
            "approval",
            "handoff"
          ],
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Details"
        }
      },
      "required": [
        "milestone",
        "kind"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "Interventions": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial"
