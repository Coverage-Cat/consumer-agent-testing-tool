      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "surface_revision": {
      "minLength": 1,
      "title": "Surface Revision",
      "type": "string"
    },
    "fixture_revision": {
      "minLength": 1,
      "title": "Fixture Revision",
      "type": "string"
    },
    "case_revision": {
      "minLength": 1,
      "title": "Case Revision",
      "type": "string"
    },
    "scenario_id": {
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "trial_id": {
      "minLength": 1,
      "title": "Trial Id",
      "type": "string"
    },
    "comparison": {
      "enum": [
        "matched",
        "control"
