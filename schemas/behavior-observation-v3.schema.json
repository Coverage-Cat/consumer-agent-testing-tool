          "title": "Completeness",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Intervention"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "completeness",
        "items"
      ],
      "title": "Interventions",
      "type": "object"
    },
    "MigrationSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "MigrationSource",
      "type": "object"
    },
    "ObservedSide": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "task_success": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Success"
        },
        "backend_state": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend State"
        },
        "surface": {
          "anyOf": [
            {
              "enum": [
                "cli-skill",
                "api-tools",
                "browser",
                "mixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface"
        },
        "operations": {
          "anyOf": [
            {
              "$ref": "#/$defs/Operations"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interventions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interventions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
